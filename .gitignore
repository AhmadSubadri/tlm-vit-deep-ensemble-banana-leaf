# Ignore Word documents, presentation files, and stray PDFs
*.docx
*.doc
*.pptx
*.ppt
*.pdf
~$*

# Explicitly allow the official IEEE Access reference papers in reference_papers/
!reference_papers/
!reference_papers/*.pdf

# Ignore large dataset archives, weights, and cached arrays
*.zip
*.tar.gz
*.pkl
*.npy
*.h5
*.weights.h5

# Python & Jupyter checkpoints
.ipynb_checkpoints/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
